while True:

   v_1 = float(input("Introducir velocidad del medio 1:"))
   ρ_1 = float(input("Introducir densidad del medio 1:"))
   v_2 = float(input("Introducir velocidad del medio 2:"))
   ρ_2 = float(input("Introducir densidad del medio 2:"))
   z_1 = ρ_1 * v_1
   z_2 = ρ_2 * v_2

   R = (z_2 - z_1) / (z_2 + z_1)

   print("El coeficiente de reflexión es:", R)

   if v_1 < v_2:
    print("Hubo aceleración al cambiar de medio.")
   else:
    print("Hubo desaceleración al cambiar de medio.")

   respuesta = str(input("¿Desea calcular un Coeficiente de Reflexión más?:").strip().lower())
   if respuesta.startswith(('s' , "y")):
     continue
   else:     
     print("Programa finalizado.")      
     break